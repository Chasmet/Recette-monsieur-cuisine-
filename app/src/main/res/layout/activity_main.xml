<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#FFF9F1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#211208">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="👨🏾‍🍳  RECETTES" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="28sp"/>
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Monsieur Cuisine" android:textColor="#F6A51A" android:textStyle="bold|italic" android:textSize="24sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="Des recettes du monde, simples et délicieuses" android:textColor="#F8E7D4" android:textSize="13sp"/>
            <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:hint="🔎  Rechercher une recette…" android:singleLine="true" android:paddingLeft="16dp" android:paddingRight="16dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Explorer" android:textStyle="bold" android:textSize="22sp" android:textColor="@color/ink"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <Button android:id="@+id/tabSelection" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="⭐ Sélection 25" android:textAllCaps="false"/>
                <Button android:id="@+id/tabComplete" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:text="🌍 Toutes les recettes" android:textAllCaps="false"/>
            </LinearLayout>
            <TextView android:id="@+id/catalogInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="14sp" android:textColor="#75675C"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Pays" android:textStyle="bold" android:textSize="19sp" android:textColor="@color/ink"/>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none"><LinearLayout android:id="@+id/countryFilters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Catégories" android:textStyle="bold" android:textSize="19sp" android:textColor="@color/ink"/>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none"><LinearLayout android:id="@+id/categoryFilters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
            <TextView android:id="@+id/resultCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textStyle="bold" android:textSize="17sp" android:textColor="@color/ink"/>
            <LinearLayout android:id="@+id/recipeContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="10dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>