<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#FFF9F1">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="#211208">
   <Button android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="‹" android:textSize="28sp"/>
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="RECETTES  Monsieur Cuisine" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="18sp"/>
  </LinearLayout>
  <ImageView android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="260dp" android:scaleType="centerCrop" android:background="#211208" android:contentDescription="Illustration de la recette"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
   <TextView android:id="@+id/recipeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/ink"/>
   <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="15sp" android:textColor="#B65B08" android:textStyle="bold"/>
   <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="16sp" android:textColor="@color/ink"/>
   <Button android:id="@+id/favoriteButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="15dp" android:text="♡ Ajouter aux favoris" android:textAllCaps="false"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Ingrédients" android:textStyle="bold" android:textSize="23sp" android:textColor="@color/ink"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Préparez tout avant de lancer le mode cuisson guidée" android:textSize="13sp" android:textColor="#75675C"/>
   <LinearLayout android:id="@+id/ingredientContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:padding="10dp"/>
   <Button android:id="@+id/copyButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="🛒 Ajouter à ma liste de courses" android:textAllCaps="false"/>
   <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="14dp" android:background="@drawable/bg_primary" android:text="▶  Démarrer la cuisson guidée" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" android:textAllCaps="false"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>